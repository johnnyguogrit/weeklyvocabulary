// Prisma schema for Weekly Vocabulary App (PostgreSQL/Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Required for Supabase
}

// User management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  role      String   @default("STUDENT") // STUDENT, TEACHER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  studentProgress StudentProgress[]
  teacherClasses  Class[]           @relation("ClassTeacher")
  accounts        Account[]
  sessions        Session[]
  enrollments     Enrollment[]
  quizSessions    QuizSession[]
  importBatches   ImportBatch[]     @relation("ImportBatchTeacher")

  @@index([email])
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Student progress tracking
model StudentProgress {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade      String // G1, G2, G3, G4, G5
  subject    String
  difficulty String @default("EASY") // EASY, MEDIUM, HARD

  // Overall progress
  totalScore        Int    @default(0)
  overallProgress   Float  @default(0)
  currentPlantStage String @default("SEEDLING") // SEEDLING, SAPLING, YOUNG_TREE, MIGHTY_OAK

  // Relations
  weekProgress WeekProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, grade, subject], name: "userId_grade_subject")
  @@index([userId, grade])
}

model WeekProgress {
  id                String          @id @default(cuid())
  studentProgressId String
  studentProgress   StudentProgress @relation(fields: [studentProgressId], references: [id], onDelete: Cascade)

  weekId    Int
  completed Boolean @default(false)
  locked    Boolean @default(true)
  score     Int     @default(0)

  // Quiz stats
  questionsCorrect Int @default(0)
  questionsTotal   Int @default(0)

  // Reading comprehension stats
  readingCompCorrect Int @default(0)
  readingCompTotal   Int @default(0)

  // Mastered keywords (stored as JSON string array)
  keywordsMastered String // JSON array: ["keyword1", "keyword2"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentProgressId, weekId])
  @@index([studentProgressId, weekId])
}

// Class management (for teacher portal)
model Class {
  id        String @id @default(cuid())
  name      String
  teacherId String
  teacher   User   @relation("ClassTeacher", fields: [teacherId], references: [id])
  grade     String // G1, G2, G3, G4, G5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollments   Enrollment[]
  importBatches ImportBatch[]

  @@index([teacherId])
}

model Enrollment {
  id        String @id @default(cuid())
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt    DateTime @default(now())
  parentEmail   String? // Parent contact email
  parentPhone   String? // Parent contact phone
  importBatchId String? // Track which import batch added this student
  comments      String? // Teacher notes

  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@unique([classId, studentId])
  @@index([studentId])
}

// Session tracking for active quiz state
model QuizSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  grade      String // G1, G2, G3, G4, G5
  subject    String
  weekId     Int
  difficulty String // EASY, MEDIUM, HARD

  // Current quiz state
  currentQuestionIndex Int     @default(0)
  selectedAnswer       String?
  isAnswered           Boolean @default(false)
  isCorrect            Boolean @default(false)
  timeRemaining        Int     @default(0)
  livesRemaining       Int     @default(0)

  // Temporary scores
  scoreThisQuestion Int @default(0)
  correctCount      Int @default(0)
  speedBonusCount   Int @default(0)

  // Quiz answers history (JSON)
  answersHistory String // JSON array of answer records

  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, status])
}

// Bulk student import tracking
model ImportBatch {
  id           String   @id @default(cuid())
  teacherId    String
  teacher      User     @relation("ImportBatchTeacher", fields: [teacherId], references: [id])
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  fileName     String // Original filename
  recordsCount Int // Total records in file
  successCount Int // Successfully imported
  failureCount Int // Failed records
  errorLog     String? // JSON array: [{row, email, error}]
  createdAt    DateTime @default(now())

  enrollments Enrollment[]

  @@index([teacherId, createdAt])
}
