# Database - Supabase PostgreSQL
# Get these from your Supabase Dashboard → Settings → Database → Connection string
# Use "Transaction mode" (Pooler) for DATABASE_URL (recommended for Next.js)
# Use "Direct connection" for DIRECT_URL (required for migrations)
DATABASE_URL="postgresql://postgres.projectid:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:password@db.projectid.supabase.co:5432/postgres"

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-generated-secret-here"
AUTH_URL="http://localhost:3000"

# Legacy for compatibility (NextAuth v5 also reads these)
NEXTAUTH_SECRET="your-generated-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# App Configuration
NODE_ENV="development"

# Production Notes:
# - AUTH_URL and NEXTAUTH_URL should be set to your production domain (e.g., https://your-app.vercel.app)
# - Generate a new AUTH_SECRET for production: openssl rand -base64 32
# - Never commit .env.local or .env.production files with real credentials
